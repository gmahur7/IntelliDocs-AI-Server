PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=1d
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Use the exact S3 URL from Bucket → Endpoint in Backblaze (region includes a number, e.g. us-east-005).
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Optional: same as the segment between s3. and .backblazeb2.com (e.g. us-east-005 — not "us-east" alone)
# B2_REGION=us-east-005
OLLAMA_BASE_URL=http://localhost:11434
# At least a 3B model; qwen2.5:7b-instruct or llama3.1:8b give noticeably better grounded answers.
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
RABBITMQ_URL=amqp://app:app@localhost:5672
RABBITMQ_INGEST_QUEUE=doc.ingest.parse
RABBITMQ_INGEST_DLQ=doc.ingest.deadletter
RABBITMQ_PREFETCH_COUNT=5
RABBITMQ_MAX_RETRIES=3
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=5
# A page with fewer than this many letters/digits is treated as scanned (no text layer).
RAG_MIN_PAGE_TEXT_CHARS=12
# Ingestion fails loudly when more than this fraction of pages are scanned.
RAG_MAX_SCANNED_PAGE_RATIO=0.8
# Context window for chat calls. Sources are trimmed to fit it; check the Ollama host has the memory.
OLLAMA_NUM_CTX=8192
# Low temperature keeps grounded answers stable between runs.
OLLAMA_TEMPERATURE=0.1
RAG_MAX_HISTORY_MESSAGES=10
RAG_MAX_HISTORY_TOKENS=1200
# Task prefixes required by nomic-embed-text (quoted: the trailing space matters).
# Changing them invalidates stored vectors — reindex every document via POST /documents/:id/reindex.
RAG_EMBED_QUERY_PREFIX="search_query: "
RAG_EMBED_DOCUMENT_PREFIX="search_document: "
